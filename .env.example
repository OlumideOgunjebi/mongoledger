# Copy to .env and change the password before running docker compose.
# SQL Server requires at least 8 characters with upper case, lower case, digits and symbols.
MSSQL_SA_PASSWORD=ChangeMe_2026!

# Resource limits keep runs comparable on one laptop (run one system at a time).
MONGO_CPUS=2
MONGO_MEM=4g
MSSQL_CPUS=2
MSSQL_MEM=4g

# Oplog size in MB (990 is the minimum; use it for the oplog rollover attack)
OPLOG_MB=2048

MONGO_URI=mongodb://localhost:27017/?replicaSet=rs0&directConnection=true
DATA_DB=bank
