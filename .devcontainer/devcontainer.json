// GitHub Codespaces / VS Code Dev Containers definition.
// Opening the repository in a codespace starts MongoDB 8.0 as a single node
// replica set next to a Python 3.12 workspace and installs the project, so a
// grader can run `python demo.py` or `mongoledger verify --design A` with no
// local installation. The app container shares the mongo container's network,
// so the default connection string (localhost:27017) works unchanged.
{
  "name": "Change stream ledger for MongoDB",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  "shutdownAction": "stopCompose",
  "postCreateCommand": "pip install --user -e '.[bench,test]' && cp -n .env.example .env || true",
  "postAttachCommand": "echo 'Ready: run  python demo.py  or  python -m pytest tests'",
  "remoteEnv": {
    "MONGO_URI": "mongodb://localhost:27017/?replicaSet=rs0&directConnection=true",
    "PATH": "${containerEnv:PATH}:/home/vscode/.local/bin"
  },
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "mongodb.mongodb-vscode"]
    },
    "codespaces": {
      "openFiles": ["README.md"]
    }
  },
  "hostRequirements": { "cpus": 2, "memory": "4gb" }
}
